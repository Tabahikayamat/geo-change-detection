import os
import cv2
from tqdm.auto import tqdm

def slice_clcd_to_256(src_dir, dest_dir, patch_size=256):
    """
    Slices the CLCD dataset (time1, time2, label) into 256x256 patches.
    The source directory must contain 'train', 'val', 'test' subfolders,
    each with 'time1', 'time2', 'label' directories.
    """
    print(f"{'='*60}")
    print(f" Slicing CLCD Dataset to {patch_size}x{patch_size} Patches")
    print(f"{'='*60}")

    # Process train, val, test splits
    for phase in ['train', 'val', 'test']:
        src_phase = os.path.join(src_dir, phase)
        if not os.path.exists(src_phase):
            print(f" [SKIP] '{phase}' folder not found. Skipping.")
            continue

        print(f"\n[PROCESSING] Slicing '{phase}' set...")

        dest_phase = os.path.join(dest_dir, phase)
        # Create destination subfolders (time1, time2, label)
        for sub in ['time1', 'time2', 'label']:
            os.makedirs(os.path.join(dest_phase, sub), exist_ok=True)

        # Use 'time1' as file reference (all three folders must have the same filenames)
        ref_dir = os.path.join(src_phase, 'time1')
        files = sorted([f for f in os.listdir(ref_dir) if f.endswith(('.png', '.tif', '.jpg'))])

        for f in tqdm(files, leave=False):
            # Load T1, T2, and Label
            img_time1 = cv2.imread(os.path.join(src_phase, 'time1', f), cv2.IMREAD_COLOR)
            img_time2 = cv2.imread(os.path.join(src_phase, 'time2', f), cv2.IMREAD_COLOR)
            img_label  = cv2.imread(os.path.join(src_phase, 'label', f), cv2.IMREAD_GRAYSCALE)

            h, w = img_time1.shape[:2]

            # Cut into non‑overlapping patches
            patch_idx = 0
            for y in range(0, h, patch_size):
                for x in range(0, w, patch_size):
                    if y + patch_size > h or x + patch_size > w:
                        continue   # skip incomplete edge patches

                    patch_idx += 1

                    crop_t1 = img_time1[y:y+patch_size, x:x+patch_size]
                    crop_t2 = img_time2[y:y+patch_size, x:x+patch_size]
                    crop_lbl = img_label[y:y+patch_size, x:x+patch_size]

                    # New filename: original_name_1.png, _2.png, …
                    name, ext = os.path.splitext(f)
                    new_name = f"{name}_{patch_idx}{ext}"

                    #  Correct folder names
                    cv2.imwrite(os.path.join(dest_phase, 'time1', new_name), crop_t1)
                    cv2.imwrite(os.path.join(dest_phase, 'time2', new_name), crop_t2)
                    cv2.imwrite(os.path.join(dest_phase, 'label', new_name), crop_lbl)

    print(f"\n{'='*60}")
    print(f" [SUCCESS] Sliced dataset saved to: {dest_dir}")
    print(f"{'='*60}")


# ==========================================
# EXECUTION 
# ==========================================
SOURCE_DIR = '/kaggle/input/datasets/ompatel179/clcd-second-task/CLCD'
SLICED_DIR = '/kaggle/working/datasets/CLCD_256'

slice_clcd_to_256(src_dir=SOURCE_DIR, dest_dir=SLICED_DIR, patch_size=256)
